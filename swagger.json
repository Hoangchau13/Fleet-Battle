  "paths": {
    "/api/admin/users/{id}/role": {
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Update User Role (Admin/SuperAdmin).",
        "description": "Thay đổi quyền hạn của user. SuperAdmin có toàn quyền (trừ tự sát/tạo SuperAdmin khác). Admin chỉ được thăng cấp Player.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID của user cần sửa",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Role mới",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRoleRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRoleRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRoleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/admin/users/{id}/status": {
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Cập nhật trạng thái User (Khóa/Mở khóa).",
        "description": "Gửi true để mở khóa (Active), false để khóa (Ban).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID của user cần sửa",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Trạng thái mới",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserStatusRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserStatusRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/admin/users/{id}": {
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "Xóa User (Phân quyền: SuperAdmin > Admin > Player).",
        "description": "SuperAdmin xóa được Admin và Player. Admin chỉ xóa được Player.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "style": "simple",
            "schema": {
              "type": "integer",
