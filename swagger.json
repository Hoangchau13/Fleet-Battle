          {
            "name": "page",
            "in": "query",
            "description": "Trang hiện tại (Mặc định: 1)",
            "style": "form",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Số lượng user mỗi trang (Mặc định: 20)",
            "style": "form",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "Từ khóa tìm kiếm (Username hoặc Email)",
            "style": "form",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
