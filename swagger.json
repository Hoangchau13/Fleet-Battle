    "/api/admin/users": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Lấy danh sách Users (có phân trang & tìm kiếm).",
        "description": "Trả về danh sách user với thông tin cơ bản. Hỗ trợ tìm kiếm theo username hoặc email.",
